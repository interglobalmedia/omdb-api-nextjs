{
	"name": "omdb-api-nextjs",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"stylelint": "stylelint \"styles/**/*.scss\"",
		"stylelint:fix": "stylelint --fix \"styles/**/*.scss\"",
		"validate": "npm run lint && npm run stylelint && npm run format:check",
		"prepare": "husky install",
		"analyze": "next analyze",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"next": "^16.4.3",
		"next-seo": "^5.15.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"sass": "^1.57.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.13.0",
		"eslint-config-next": "^16.4.3",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^8.0.2",
		"lint-staged": "^13.1.0",
		"prettier": "^3.9.10",
		"stylelint": "^17.16.0",
		"stylelint-config-standard-scss": "^17.0.0"
	},
	"lint-staged": {
		"*.+(js|jsx|ts|tsx)": [
			"eslint --fix"
		],
		"*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
			"prettier --write"
		]
	},
	"engines": {
		"node": "24.x"
	}
}
